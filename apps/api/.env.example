PORT=3000
DATABASE_URL="postgresql://academia:academia@localhost:5432/academia?schema=public"
# Obrigatório, com pelo menos 32 caracteres: a API não sobe com ele vazio ou curto. Gere um valor com: openssl rand -hex 32
JWT_SECRET=
# Segundos (28800) ou número com unidade s, m, h ou d (8h). Vazio ou inválido impede a API de subir.
JWT_EXPIRES_IN=8h
