generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum Cargo {
  ADMIN
  RECEPCIONISTA
  INSTRUTOR
}

/// Membros não são apagados: desative com `ativo = false` para preservar o histórico.
model Membro {
  id           String   @id @default(uuid(7)) @db.Uuid
  nome         String
  cpf          String   @unique @db.Char(11)
  telefone     String
  endereco     String
  ativo        Boolean  @default(true)
  dataCadastro DateTime @default(now()) @map("data_cadastro")

  treinos    Treino[]
  pagamentos Pagamento[]
  atividades HistoricoAtividade[]

  @@map("membros")
}

/// Ficha de treino planejada para o membro.
model Treino {
  id         String   @id @default(uuid(7)) @db.Uuid
  membroId   String   @map("membro_id") @db.Uuid
  tipo       String
  descricao  String
  /// duração em minutos
  duracao    Int
  dataInicio DateTime @map("data_inicio")

  membro     Membro               @relation(fields: [membroId], references: [id], onDelete: Restrict)
  atividades HistoricoAtividade[]

  @@index([membroId])
  @@map("treinos")
}

/// Mensalidade do membro. Está atrasada quando `dataVencimento` passou e `dataPagamento` é nula.
model Pagamento {
  id             String          @id @default(uuid(7)) @db.Uuid
  membroId       String          @map("membro_id") @db.Uuid
  valor          Decimal         @db.Decimal(10, 2)
  dataVencimento DateTime        @map("data_vencimento") @db.Date
  /// nula enquanto o pagamento não foi feito
  dataPagamento  DateTime?       @map("data_pagamento")
  status         StatusPagamento @default(PENDENTE)

  membro Membro @relation(fields: [membroId], references: [id], onDelete: Restrict)

  @@index([membroId])
  @@index([status, dataVencimento])
  @@map("pagamentos")
}

/// Registro de cada execução de atividade pelo membro, lançado por um funcionário.
model HistoricoAtividade {
  id            String   @id @default(uuid(7)) @db.Uuid
  membroId      String   @map("membro_id") @db.Uuid
  funcionarioId String?  @map("funcionario_id") @db.Uuid
  /// treino ao qual a atividade pertence, se houver
  treinoId      String?  @map("treino_id") @db.Uuid
  atividade     String
  data          DateTime
  /// tempo de execução em minutos
  tempoExecucao Int      @map("tempo_execucao")

  membro      Membro       @relation(fields: [membroId], references: [id], onDelete: Restrict)
  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  treino      Treino?      @relation(fields: [treinoId], references: [id], onDelete: SetNull)

  @@index([membroId])
  @@index([funcionarioId])
  @@index([treinoId])
  @@map("historico_atividades")
}

/// Funcionários não são apagados: desative com `ativo = false` para preservar o histórico.
model Funcionario {
  id        String  @id @default(uuid(7)) @db.Uuid
  nome      String
  cargo     Cargo
  login     String  @unique
  /// hash da senha (nunca a senha em texto puro)
  senhaHash String  @map("senha_hash")
  ativo     Boolean @default(true)

  atividades HistoricoAtividade[]

  @@map("funcionarios")
}
